{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.northstar.example/contracts/theme-manifest/1.0.0",
  "title": "Northstar — Theme Manifest",
  "description": "Immutable, schema-shaped theme manifest (FR-EXT-006). Themes change only presentation and carry no permission surface.",
  "type": "object",
  "required": ["theme_id", "version", "compatibility", "modes"],
  "properties": {
    "theme_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "compatibility": {
      "type": "object",
      "required": ["design_system"],
      "properties": {
        "design_system": { "type": "string", "minLength": 1 }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "supports_rtl": { "type": "boolean" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot"],
        "properties": {
          "slot": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
