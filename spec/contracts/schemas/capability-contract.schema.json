{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.northstar.example/contracts/capability-contract/1.0.0",
  "title": "Northstar — Capability Contract",
  "description": "Immutable, schema-shaped capability contract describing a stable extension API surface (FR-EXT-001).",
  "type": "object",
  "required": [
    "capability_id",
    "contract_version",
    "owner_module",
    "kind",
    "input_schema",
    "output_schema",
    "policy"
  ],
  "properties": {
    "capability_id": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "string", "minLength": 1 },
    "owner_module": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "input_schema": { "type": "string", "minLength": 1 },
    "output_schema": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "required": ["action", "resource_type"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "resource_type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
