{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.northstar.example/contracts/cms-contribution/1.0.0",
  "title": "Northstar — CMS Studio Contribution",
  "description": "A single module's declared Governance Studio surfaces (navigation, workbenches, widgets) and the permissions they require (FR-CMS-001). Validated deny-by-default by the ContributionRegistry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contribution_version", "module_id", "compatibility", "permissions"],
  "properties": {
    "contribution_version": {
      "type": "string",
      "const": "1.0"
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["studio_api"],
      "properties": {
        "studio_api": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label_key", "workbench_id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label_key": { "type": "string", "minLength": 1 },
          "workbench_id": { "type": "string", "minLength": 1 },
          "order": { "type": "integer" },
          "icon": { "type": "string" }
        }
      }
    },
    "workbenches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "route", "component"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "minLength": 1 },
          "component": { "type": "string", "minLength": 1 },
          "required_permissions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "danger_level": {
            "type": "string",
            "enum": ["normal", "sensitive", "dangerous"]
          }
        }
      }
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slot", "component"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "slot": { "type": "string", "minLength": 1 },
          "component": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
