{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.northstar.example/modules/identity/authentication/1.0.0",
  "title": "Northstar Identity — Authentication Payloads",
  "description": "Module-local request/response shapes for the identity authentication and session capabilities (OIDC/OAuth Authorization Code + PKCE; server-managed sessions).",
  "$defs": {
    "BeginAuthentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redirect_uri"],
      "properties": {
        "redirect_uri": {
          "type": "string",
          "format": "uri"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "CompleteAuthentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "state"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SessionView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "subject_id", "assurance"],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "subject_id": {
          "type": "string"
        },
        "assurance": {
          "type": "string",
          "enum": [
            "unauthenticated",
            "single_factor",
            "multi_factor",
            "phishing_resistant"
          ]
        },
        "tenant_scope": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
